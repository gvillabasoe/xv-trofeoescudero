// ─────────────────────────────────────────────────────────────────────────────
// Sistema · Better Auth (identidad canónica; sin tabla AdminUser duplicada)
// Campos según Better Auth 1.7.7 (núcleo + plugins admin y twoFactor + rate limit en base de datos).
// Better Auth genera sus propios ids, por eso estas tablas no tienen valor por defecto en `id`.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// Plugin admin: «admin»; «editor» queda reservado.
  role             String?
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime? @db.Timestamptz(3)
  /// Plugin twoFactor. El CMS exige true.
  twoFactorEnabled Boolean?  @default(false)

  sessions     Session[]
  accounts     Account[]
  twoFactors   TwoFactor[]
  adminProfile AdminProfile?

  auditLogs                      AuditLog[]                @relation("AuditLogActor")
  createdRevisions               ContentRevision[]         @relation("ContentRevisionCreatedBy")
  lastPublishedSiteStates        SiteState[]               @relation("SiteStateLastPublishedBy")
  uploadedMedia                  MediaAsset[]              @relation("MediaAssetUploadedBy")
  consentConfirmedMedia          MediaAsset[]              @relation("MediaAssetConsentConfirmedBy")
  submissionStatusChanges        SubmissionStatusHistory[] @relation("SubmissionStatusChangedBy")
  authoredSubmissionNotes        SubmissionNote[]          @relation("SubmissionNoteAuthor")
  updatedPolicySettings          PolicySettings[]          @relation("PolicySettingsUpdatedBy")
  updatedSiteSettings            SiteSettings[]            @relation("SiteSettingsUpdatedBy")
  updatedContactChannels         ContactChannel[]          @relation("ContactChannelUpdatedBy")
  updatedPageSections            PageSection[]             @relation("PageSectionUpdatedBy")
  updatedHeroContents            HeroContent[]             @relation("HeroContentUpdatedBy")
  updatedHeroFigures             HeroFigure[]              @relation("HeroFigureUpdatedBy")
  updatedFamilyContents          FamilyContent[]           @relation("FamilyContentUpdatedBy")
  updatedFamilyMembers           FamilyMember[]            @relation("FamilyMemberUpdatedBy")
  updatedDayContents             DayContent[]              @relation("DayContentUpdatedBy")
  updatedDaySteps                DayStep[]                 @relation("DayStepUpdatedBy")
  updatedCollaborationContents   CollaborationContent[]    @relation("CollaborationContentUpdatedBy")
  updatedClosingContents         ClosingContent[]          @relation("ClosingContentUpdatedBy")
  updatedLegalPages              LegalPage[]               @relation("LegalPageUpdatedBy")
  updatedCollaborationRoutes     CollaborationRoute[]      @relation("CollaborationRouteUpdatedBy")
  updatedRouteItems              RouteItem[]               @relation("RouteItemUpdatedBy")
  updatedOpportunities           Opportunity[]             @relation("OpportunityUpdatedBy")
  updatedCompetitionHoles        CompetitionHole[]         @relation("CompetitionHoleUpdatedBy")
  updatedSponsorCategories       SponsorCategory[]         @relation("SponsorCategoryUpdatedBy")
  updatedSponsors                Sponsor[]                 @relation("SponsorUpdatedBy")
  updatedMedia                   MediaAsset[]              @relation("MediaAssetUpdatedBy")
  updatedSubmissions             Submission[]              @relation("SubmissionUpdatedBy")
  updatedSubmissionNotes         SubmissionNote[]          @relation("SubmissionNoteUpdatedBy")
}

/// IP y user agent: solo seguridad; nunca se copian a AuditLog (§16.1).
model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Plugin admin
  impersonatedBy String?

  @@index([userId])
}

/// `password` guarda el hash scrypt de Better Auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// Plugin twoFactor: secreto TOTP y códigos de recuperación, cifrados por Better Auth.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
}

/// Rate limiting de Better Auth en base de datos.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ─────────────────────────────────────────────────────────────────────────────
// Sistema · propio
// ─────────────────────────────────────────────────────────────────────────────

model AdminProfile {
  id          String    @id @default(cuid(2))
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  /// Pequeño y sin datos sensibles.
  preferences Json?
  lastSeenAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

/// Singleton (id = 1): versión publicada vigente.
model SiteState {
  id                    Int              @id @default(1)
  publishedRevisionId   String?
  publishedRevision     ContentRevision? @relation(fields: [publishedRevisionId], references: [id], onDelete: Restrict)
  hasUnpublishedChanges Boolean          @default(false)
  lastPublishedAt       DateTime?        @db.Timestamptz(3)
  lastPublishedById     String?
  lastPublishedBy       User?            @relation("SiteStateLastPublishedBy", fields: [lastPublishedById], references: [id], onDelete: SetNull)
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
}

/// Inmutable: el snapshot solo contiene lo público, validado con Zod.
model ContentRevision {
  id               String             @id @default(cuid(2))
  revisionNumber   Int                @unique
  schemaVersion    Int
  /// SHA-256 del JSON canónico.
  contentHash      String
  snapshot         Json
  createdById      String?
  createdBy        User?              @relation("ContentRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  publishedAt      DateTime           @db.Timestamptz(3)
  /// Relleno cuando la revisión es una restauración.
  sourceRevisionId String?
  sourceRevision   ContentRevision?   @relation("ContentRevisionSource", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  restorations     ContentRevision[]  @relation("ContentRevisionSource")
  publishComment   String?
  mediaRefs        RevisionMediaRef[]
  siteStates       SiteState[]

  @@index([createdAt(sort: Desc)])
}

/// Impide borrar un medio mientras alguna revisión retenida lo use.
model RevisionMediaRef {
  revisionId String
  revision   ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  mediaId    String
  media      MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([revisionId, mediaId])
  @@index([mediaId])
}

/// Singleton (id = 1). `environment` se fija al crear cada base de datos y el build lo comprueba.
model PolicySettings {
  id                        Int             @id @default(1)
  environment               DataEnvironment
  /// Propuesta pendiente de validación legal; configurable.
  submissionAnonymizeMonths Int             @default(24)
  /// Máximo 30 (CHECK en SQL).
  fingerprintMaxDays        Int             @default(30)
  auditRetentionMonths      Int             @default(24)
  revisionsToKeep           Int             @default(50)
  retiredMediaPurgeDays     Int             @default(30)
  /// En PROD no se puede desactivar (CHECK en SQL).
  requireTotp               Boolean         @default(true)
  version                   Int             @default(1)
  createdAt                 DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById               String?
  updatedBy                 User?           @relation("PolicySettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Registro de ejecuciones únicas de datos (0002): el bootstrap del contenido inicial y cada backfill.
/// Una fila por clave (única): una ejecución registrada no se repite nunca.
model SeedRun {
  id          String          @id @default(cuid(2))
  /// Por ejemplo, «initial-content-v1».
  key         String          @unique
  kind        SeedRunKind
  version     Int
  /// SHA-256 del conjunto de datos (bootstrap) o de la definición (backfill).
  checksum    String
  environment DataEnvironment
  completedAt DateTime        @db.Timestamptz(3)
  /// Resumen no sensible: modo, recuentos, revisión verificada.
  metadata    Json?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
}

/// Append-only (trigger en SQL). Nunca guarda contraseñas, tokens, mensajes completos, emails, teléfonos ni IP.
model AuditLog {
  id         String         @id @default(cuid(2))
  at         DateTime       @default(now()) @db.Timestamptz(3)
  actorId    String?
  actor      User?          @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// 0002. Las filas anteriores (todas del seed, sin usuario) quedan como SYSTEM.
  actorType  AuditActorType @default(SYSTEM)
  action     AuditAction
  entityType String
  entityId   String?
  requestId  String?
  /// Resumen no sensible.
  summary    String?

  @@index([at])
  @@index([entityType, entityId])
  @@index([action, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// Editorial (borrador editable → snapshot)
// ─────────────────────────────────────────────────────────────────────────────

/// Singleton (id = 1). Los datos del titular legal quedan vacíos hasta P2.
model SiteSettings {
  id                Int          @id @default(1)
  siteName          String
  editionLabel      String
  editionNumber     Int
  eventDate         DateTime     @db.Date
  venueName         String
  location          String
  afterPartyName    String?
  seoTitle          String
  seoDescription    String
  legalOwnerName    String?
  legalOwnerTaxId   String?
  legalOwnerAddress String?
  /// Imagen OG, vía MediaUsage.
  mediaUsages       MediaUsage[]
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById       String?
  updatedBy         User?        @relation("SiteSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Solo se publica si está activo (apagado por defecto).
model ContactChannel {
  id            String             @id @default(cuid(2))
  type          ContactChannelType
  label         String
  value         String
  url           String?
  isActive      Boolean            @default(false)
  showInClosing Boolean            @default(false)
  showInFooter  Boolean            @default(false)
  sortOrder     Int                @default(0)
  version       Int                @default(1)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById   String?
  updatedBy     User?              @relation("ContactChannelUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([type, value])
}

/// Los 5 bloques fijos. HERO y COLABORAR no se pueden ocultar (CHECK en SQL).
model PageSection {
  id            String                @id @default(cuid(2))
  key           SectionKey            @unique
  indexLabel    String
  isVisible     Boolean               @default(true)
  sortOrder     Int
  hero          HeroContent?
  family        FamilyContent?
  day           DayContent?
  collaboration CollaborationContent?
  closing       ClosingContent?
  version       Int                   @default(1)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById   String?
  updatedBy     User?                 @relation("PageSectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model HeroContent {
  id                 String       @id @default(cuid(2))
  sectionId          String       @unique
  section            PageSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  eyebrow            String
  titleLine1         String
  titleLine2         String?
  lead               String
  primaryCtaLabel    String
  secondaryCtaLabel  String
  brandCardTitle     String
  brandCardText      String
  brandCardLinkLabel String
  figures            HeroFigure[]
  mediaUsages        MediaUsage[]
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById        String?
  updatedBy          User?        @relation("HeroContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Franja de cifras. `internalSource` es privado y nunca entra en el snapshot.
model HeroFigure {
  id             String      @id @default(cuid(2))
  heroId         String
  hero           HeroContent @relation(fields: [heroId], references: [id], onDelete: Cascade)
  label          String
  value          String
  caption        String?
  isVisible      Boolean     @default(true)
  sortOrder      Int
  internalSource String?
  version        Int         @default(1)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById    String?
  updatedBy      User?       @relation("HeroFigureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([heroId, sortOrder])
}

model FamilyContent {
  id                     String         @id @default(cuid(2))
  sectionId              String         @unique
  section                PageSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title                  String
  secondGenerationLabel  String
  secondGenerationText   String
  thirdGenerationLabel   String
  thirdGenerationText    String
  thirdGenerationCaption String?
  members                FamilyMember[]
  mediaUsages            MediaUsage[]
  version                Int            @default(1)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById            String?
  updatedBy              User?          @relation("FamilyContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// `ageManual`: campo editorial opcional; oculto si está vacío. Sin cálculo automático ni fecha de nacimiento.
model FamilyMember {
  id          String           @id @default(cuid(2))
  familyId    String
  family      FamilyContent    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name        String
  generation  FamilyGeneration
  text        String
  caption     String?
  ageManual   Int?
  isVisible   Boolean          @default(true)
  sortOrder   Int
  mediaUsages MediaUsage[]
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   User?            @relation("FamilyMemberUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([familyId, sortOrder])
}

/// El día + 3ª Generación: textos de Norte, Sur y Luz de Mar.
model DayContent {
  id             String       @id @default(cuid(2))
  sectionId      String       @unique
  section        PageSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title          String
  lead           String
  northLabel     String
  northTitle     String
  northText      String
  northHighlight String?
  northBridge    String?
  southLabel     String
  southTitle     String
  southText      String
  afterLabel     String
  afterTitle     String
  afterText      String
  steps          DayStep[]
  mediaUsages    MediaUsage[]
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById    String?
  updatedBy      User?        @relation("DayContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Pasos del recorrido. `time` es opcional (P7) y se oculta si está vacía.
model DayStep {
  id          String     @id @default(cuid(2))
  dayId       String
  day         DayContent @relation(fields: [dayId], references: [id], onDelete: Cascade)
  label       String
  time        String?
  isVisible   Boolean    @default(true)
  sortOrder   Int
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   User?      @relation("DayStepUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([dayId, sortOrder])
}

