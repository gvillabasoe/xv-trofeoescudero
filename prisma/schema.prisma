  INICIO_SESION
  INICIO_SESION_FALLIDO
  CIERRE_SESION
  TOTP_ACTIVADO
  TOTP_RESTABLECIDO
  CODIGOS_RECUPERACION_REGENERADOS
  SESION_REVOCADA
  EMERGENCIA_USADA
  USUARIO_CREADO
  USUARIO_BLOQUEADO
  USUARIO_ELIMINADO
  CONTENIDO_GUARDADO
  PUBLICACION
  RESTAURACION
  MEDIO_SUBIDO
  MEDIO_REVISADO
  MEDIO_RETIRADO
  MEDIO_PURGADO
  PATROCINADOR_GUARDADO
  PATROCINADOR_ARCHIVADO
  PROPUESTA_ESTADO
  PROPUESTA_NOTA
  PROPUESTA_ARCHIVADA
  PROPUESTA_ANONIMIZADA
  PROPUESTA_ELIMINADA
  EXPORTACION_CSV
  CONFIGURACION_GUARDADA
  RETENCION_EJECUTADA
  RESET_NO_PRODUCTIVO
