  closingTitleLine1 String
  closingTitleLine2 String?
  closingText       String
  closingMicrocopy  String?
  closingCtaLabel   String
  mediaUsages       MediaUsage[]
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById       String?
  updatedBy         User?        @relation("ClosingContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// privacidad · aviso-legal
model LegalPage {
  id          String         @id @default(cuid(2))
  slug        String         @unique
  title       String
  /// Markdown limitado.
  body        String
  isComplete  Boolean        @default(false)
  versions    LegalVersion[]
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   User?          @relation("LegalPageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Inmutable: cada propuesta guarda la versión exacta que se aceptó.
model LegalVersion {
  id           String       @id @default(cuid(2))
  legalPageId  String
  legalPage    LegalPage    @relation(fields: [legalPageId], references: [id], onDelete: Restrict)
  versionLabel String
  bodyHash     String
  body         String
  publishedAt  DateTime     @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  submissions  Submission[]

  @@unique([legalPageId, versionLabel])
}

// ─────────────────────────────────────────────────────────────────────────────
// Comercial
// ─────────────────────────────────────────────────────────────────────────────

model CollaborationRoute {
  id            String            @id @default(cuid(2))
  key           RouteKey          @unique
  number        Int
  title         String
  subtitle      String
  cardCopy      String
  ctaLabel      String
  /// Tipo preseleccionado en el formulario.
  formType      CollaborationType
  isVisible     Boolean           @default(true)
  sortOrder     Int
  items         RouteItem[]
  opportunities Opportunity[]
  mediaUsages   MediaUsage[]
  version       Int               @default(1)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById   String?
  updatedBy     User?             @relation("CollaborationRouteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model RouteItem {
  id          String             @id @default(cuid(2))
  routeId     String
  route       CollaborationRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  kind        RouteItemKind
  text        String
  sortOrder   Int
  version     Int                @default(1)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   User?              @relation("RouteItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([routeId, kind, sortOrder])
}

/// `availability` y `internalNotes` son privados. El estado solo se publica con showStatusPublicly (apagado).
model Opportunity {
  id                 String                  @id @default(cuid(2))
  key                String                  @unique
  routeId            String
  route              CollaborationRoute      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  holeId             String?
  hole               CompetitionHole?        @relation(fields: [holeId], references: [id], onDelete: SetNull)
  name               String
  publicDescription  String?
  maxSponsors        Int?
  availability       OpportunityAvailability @default(DISPONIBLE)
  showStatusPublicly Boolean                 @default(false)
  internalNotes      String?
  isVisible          Boolean                 @default(true)
  sortOrder          Int
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById        String?
  updatedBy          User?                   @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([routeId, sortOrder])
  @@index([availability])
}

/// 18 hoyos (CHECK 1–18 en SQL). El campo (P8) está oculto mientras no se confirme.
model CompetitionHole {
  id               String           @id @default(cuid(2))
  number           Int              @unique
  contestType      HoleContestType?
  par              Int?
  course           GolfCourse?
  showCourse       Boolean          @default(false)
  isContestVisible Boolean          @default(true)
  opportunities    Opportunity[]
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById      String?
  updatedBy        User?            @relation("CompetitionHoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model SponsorCategory {
  id                  String    @id @default(cuid(2))
  name                String    @unique
  slug                String    @unique
  requiresLegalReview Boolean   @default(false)
  sortOrder           Int       @default(0)
  sponsors            Sponsor[]
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById         String?
  updatedBy           User?     @relation("SponsorCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Solo se publica si: confirmed ∧ publicVisibility ∧ lifecycle = ACTIVO ∧ legalReview ∈ {NO_REQUERIDA, APROBADA}.
/// No existe ningún estado de «posible patrocinador». Se archiva, no se borra.
model Sponsor {
  id               String                  @id @default(cuid(2))
  name             String
  slug             String                  @unique
  relationshipType SponsorRelationshipType
  temporalRelation SponsorTemporalRelation
  confirmed        Boolean                 @default(false)
  source           SponsorSource
  sourceNote       String?
  categoryId       String
  category         SponsorCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Interruptor independiente del hecho histórico.
  publicVisibility Boolean                 @default(false)
  logoPermission   LogoPermission          @default(PENDIENTE)
  legalReview      LegalReviewStatus       @default(PENDIENTE)
  sortOrder        Int                     @default(0)
  lifecycle        SponsorLifecycle        @default(ACTIVO)
  url              String?
  shortDescription String?
  /// 0002. Papel actual conocido, independiente de la relación histórica (p. ej., «AfterParty oficial»).
  currentRoleLabel String?
  /// 0002. Ediciones en las que consta la relación, si se conocen (p. ej., «X edición»).
  editionsNote     String?
  mediaUsages      MediaUsage[]
  version          Int                     @default(1)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById      String?
  updatedBy        User?                   @relation("SponsorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([temporalRelation, lifecycle, sortOrder])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Medios
// ─────────────────────────────────────────────────────────────────────────────

/// Privado hasta su publicación. Sensible si aparecen personas. Punto focal entre 0 y 1 (CHECK en SQL).
model MediaAsset {
  id                       String              @id @default(cuid(2))
  kind                     MediaKind
  reviewState              MediaReviewState    @default(SUBIDA)
  privatePathname          String
  /// Detectado por el contenido real del archivo.
  sourceMime               String
  sizeBytes                Int
  width                    Int
  height                   Int
  megapixels               Float
  sha256                   String              @unique
  /// Obligatorio para publicar.
  altText                  String?
  caption                  String?
  description              String?
  focalX                   Float               @default(0.5)
  focalY                   Float               @default(0.5)
  hasIdentifiablePeople    Boolean             @default(false)
  includesMinors           Boolean             @default(false)
  consentConfirmed         Boolean             @default(false)
  guardianConsentConfirmed Boolean             @default(false)
  consentConfirmedAt       DateTime?           @db.Timestamptz(3)
  consentConfirmedById     String?
  consentConfirmedBy       User?               @relation("MediaAssetConsentConfirmedBy", fields: [consentConfirmedById], references: [id], onDelete: SetNull)
  retiredAt                DateTime?           @db.Timestamptz(3)
  retiredReason            MediaRetiredReason?
  uploadedById             String?
  uploadedBy               User?               @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  variants                 MediaVariant[]
  usages                   MediaUsage[]
  revisionRefs             RevisionMediaRef[]
  version                  Int                 @default(1)
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById              String?
  updatedBy                User?               @relation("MediaAssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// `publicPathname` es inmutable y versionado (incluye el hash).
model MediaVariant {
  id             String      @id @default(cuid(2))
  mediaId        String
  media          MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  format         MediaFormat
  width          Int
  publicPathname String      @unique
  publicUrl      String
  sizeBytes      Int
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([mediaId, format, width])
}

/// Exactamente una FK de destino no nula (CHECK en SQL).
model MediaUsage {
  id               String              @id @default(cuid(2))
  mediaId          String
  media            MediaAsset          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  slot             MediaSlot
  heroContentId    String?
  heroContent      HeroContent?        @relation(fields: [heroContentId], references: [id], onDelete: Cascade)
  familyMemberId   String?
  familyMember     FamilyMember?       @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyContentId  String?
  familyContent    FamilyContent?      @relation(fields: [familyContentId], references: [id], onDelete: Cascade)
  dayContentId     String?
  dayContent       DayContent?         @relation(fields: [dayContentId], references: [id], onDelete: Cascade)
  routeId          String?
  route            CollaborationRoute? @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sponsorId        String?
  sponsor          Sponsor?            @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  closingContentId String?
  closingContent   ClosingContent?     @relation(fields: [closingContentId], references: [id], onDelete: Cascade)
  siteSettingsId   Int?
  siteSettings     SiteSettings?       @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([slot, heroContentId, mediaId])
  @@unique([slot, familyMemberId, mediaId])
  @@unique([slot, familyContentId, mediaId])
  @@unique([slot, dayContentId, mediaId])
  @@unique([slot, routeId, mediaId])
  @@unique([slot, sponsorId, mediaId])
  @@unique([slot, closingContentId, mediaId])
  @@unique([slot, siteSettingsId, mediaId])
  @@index([mediaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Formularios
// ─────────────────────────────────────────────────────────────────────────────

/// Privado y sensible. Sin IP en bruto. Sin consentimiento de marketing ni newsletter.
/// `isSynthetic` marca las propuestas ficticias del seed no productivo.
model Submission {
  id                    String                    @id @default(cuid(2))
  name                  String
  company               String
  email                 String
  jobTitle              String?
  phone                 String?
  collaborationType     CollaborationType
  originRouteKey        String?
  originHoleNumber      Int?
  /// Ruta + tipo preseleccionado.
  formOrigin            String
  message               String
  consentAt             DateTime                  @db.Timestamptz(3)
  consentLegalVersionId String
  consentLegalVersion   LegalVersion              @relation(fields: [consentLegalVersionId], references: [id], onDelete: Restrict)
  /// Texto exacto de la casilla aceptada.
  consentText           String
  status                SubmissionStatus          @default(NUEVA)
  archivedAt            DateTime?                 @db.Timestamptz(3)
  readAt                DateTime?                 @db.Timestamptz(3)
  anonymizedAt          DateTime?                 @db.Timestamptz(3)
  /// Base para la retención.
  lastActivityAt        DateTime                  @default(now()) @db.Timestamptz(3)
  sourcePath            String?
  referrer              String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmTerm               String?
  utmContent            String?
  isSynthetic           Boolean                   @default(false)
  statusHistory         SubmissionStatusHistory[]
  notes                 SubmissionNote[]
  version               Int                       @default(1)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById           String?
  updatedBy             User?                     @relation("SubmissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([archivedAt])
  @@index([collaborationType])
  @@index([lastActivityAt])
  @@index([email])
}

model SubmissionStatusHistory {
  id           String            @id @default(cuid(2))
  submissionId String
  submission   Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fromStatus   SubmissionStatus?
  toStatus     SubmissionStatus
  changedById  String?
  changedBy    User?             @relation("SubmissionStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt    DateTime          @default(now()) @db.Timestamptz(3)
  note         String?

  @@index([submissionId, changedAt])
}

model SubmissionNote {
  id           String     @id @default(cuid(2))
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?      @relation("SubmissionNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body         String
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById  String?
  updatedBy    User?      @relation("SubmissionNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

/// `fingerprint` = HMAC-SHA256 de la IP normalizada con FINGERPRINT_HMAC_SECRET. Caduca en 30 días como máximo (CHECK en SQL).
model AbuseCounter {
  id          String      @id @default(cuid(2))
  fingerprint String
  action      AbuseAction
  windowStart DateTime    @db.Timestamptz(3)
  count       Int         @default(0)
  expiresAt   DateTime    @db.Timestamptz(3)

  @@unique([fingerprint, action, windowStart])
  @@index([expiresAt])
}
